// This is your Prisma schema file
// For PostgreSQL (Supabase)

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String?   @unique
  emailVerified Boolean   @default(false)
  name          String?
  nameChangedAt DateTime?
  image         String?
  password      String?
  passwordResetToken String?
  passwordResetExpiry DateTime?
  googleId      String?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isBlocked     Boolean   @default(false)
  isRestricted  Boolean   @default(false)
  restrictionReason String?
  warnings      Warning[]
  posts         Post[]
  comments      Comment[]
  accounts      Account[]
  sessions      Session[]
  chatMessages  ChatMessage[]
  reputation    Int       @default(0)
  votes         Vote[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Post {
  id              String    @id @default(uuid())
  title           String
  description     String    @db.Text
  images          String[]
  videos          String[]
  facebookUrl     String?
  instagramUrl    String?
  tiktokUrl       String?
  status          PostStatus @default(PENDING)
  isPinned        Boolean   @default(false)
  isAnonymous     Boolean   @default(false)
  pinnedAt        DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  editedAt        DateTime?
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments        Comment[]
  warnings        PostWarning[]
  votes           Vote[]
}

enum PostStatus {
  PENDING
  APPROVED
  REJECTED
}

model Comment {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Warning {
  id        String   @id @default(uuid())
  message   String   @db.Text
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostWarning {
  id        String   @id @default(uuid())
  message   String   @db.Text
  createdAt DateTime @default(now())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(uuid())
  content   String   @db.Text
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  type      TokenType
  expires   DateTime
  createdAt DateTime @default(now())
}

enum TokenType {
  REGISTER
  RESET_PASSWORD
}

model TwoFactorLogin {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Update {
  id        String   @id @default(uuid())
  version   String
  title     String
  content   String   @db.Text
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  authorId  String
}

model SystemMaintenance {
  id          String    @id @default(uuid())
  type        String    // "profile" - typ utrzymania
  reason      String    // Powód wyłączenia
  startTime   DateTime  @default(now())
  endTime     DateTime  // Kiedy się automatycznie odblokowuje
  isActive    Boolean   @default(true)
  createdBy   String    // Admin ID który utworzył
  createdAt   DateTime  @default(now())
}

model Announcement {
  id          String    @id @default(uuid())
  message     String    // Treść ogłoszenia
  type        String    @default("info") // "info", "warning", "error", "success"
  isActive    Boolean   @default(true)
  createdBy   String    // Admin ID który utworzył
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Vote {
  id        String   @id @default(uuid())
  type      VoteType
  userId    String
  postId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

enum VoteType {
  UPVOTE
  DOWNVOTE
}
